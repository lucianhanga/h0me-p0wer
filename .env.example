# Anker cloud account (used only by the backend, never sent to the browser)
ANKER_EMAIL=your@email.com
ANKER_PASSWORD=your-password
ANKER_COUNTRY=DE

# Smart Meter Gen 2 on your LAN (enable Modbus TCP in the Anker app:
# Smart Meter Gen 2 -> Settings -> Three-Party Control Settings -> Modbus TCP)
METER_IP=192.168.1.102
METER_PORT=502

# Poll cadence (ms, default 1000 — the meter's registers update ~1 s, so
# this is the fastest cadence that yields new values; the WS push to the UI
# is instant on top of it. Set 500 only to experiment — below ~1 s you
# mostly re-read the same value) and transient mode:
# MODBUS_TRANSIENT=true connects-reads-disconnects each cycle instead of
# holding the connection — lets two instances (dev + prod) share the meter's
# single Modbus connection. Use POLL_INTERVAL_MS=20000 with it.
# POLL_INTERVAL_MS=1000
# MODBUS_TRANSIENT=false

# Solarbank 2 E1600 Plus (battery) IP — informational only for now:
# the battery has NO local API (no Modbus), data comes via the Anker cloud.
# Fill in for documentation/future use.
BATTERY_IP=

# Backend listen port
PORT=3001

# Host interface Docker publishes that port on. Default (unset) is all
# interfaces (LAN-reachable). Set to 127.0.0.1 so the app is reachable ONLY
# through the tunnel, never directly on the LAN:
# BIND_IP=127.0.0.1

# Anker site override — only needed if automatic resolution picks the wrong
# site (multi-site accounts). By default the server pins itself to the site
# whose device list contains the local meter (METER_IP)'s SN.
# SITE_ID=

# Set to false to run meter-only (no Anker cloud login at all — useful while
# the account is rate-limited; grid data keeps flowing via Modbus)
CLOUD_ENABLED=true

# Electricity tariff (EUR per kWh) — used for the cost tiles on the dashboard
TARIFF_EUR_PER_KWH=0.30

# Power plan (server/power-plan.js): how much grid import to leave alone
# instead of covering it from the battery (W), and the safety margin added
# above the account's discharge floor when the battery is topping up the
# house continuously ("House priority" strategy / manual discharge toggle).
# Deployment-time only — not adjustable from the Strategy tab UI.
GRID_TARGET_W=25
DISCHARGE_TOLERANCE_PCT=3

# PIN required by the UI to change the distribution strategy / discharge
# trigger (POST /api/power-plan/strategy). Defaults to 0000 when unset.
# STRATEGY_PIN=0000

# Power-plan tuning (defaults shown; all optional, deployment-time only):
# hysteresis latches (percentage points) so SOC jitter at the charge ceiling
# or discharge floor doesn't flip behavior, the battery_priority hold-phase
# hill-climb probe (step size / min interval), and the export watchdog's
# minimum export power that triggers an immediate preset correction.
# CHARGE_RESUME_HYSTERESIS_PCT=3
# DISCHARGE_RESUME_HYSTERESIS_PCT=3
# PROBE_STEP_W=150
# PROBE_MIN_INTERVAL_MS=120000
# EXPORT_CORRECT_MIN_W=20

# Expansion-pack capacity (kWh) per attached pack (e.g. BP5000 = 5.0) — the
# cloud reports the pack COUNT only, never the model, so total capacity is
# base + N × this value. Only needed if yours differs.
# EXPANSION_PACK_KWH=5.0

# Verbose MQTT logging (every inbound message + parse failures) — debugging
# only, very noisy.
# MQTT_DEBUG=1

# Set to true on any instance that must NEVER write to the real battery
# schedule (a dev/secondary instance running alongside production against
# the same meter/Anker account). Forces the power plan disabled on startup
# and makes POST /api/power-plan/enable refuse outright, regardless of
# persisted state — only one instance should ever hold the battery schedule.
# POWER_PLAN_DISABLE=true

# Welcome tab (AI briefing). HOME_ADDRESS is geocoded once (Nominatim);
# PV_* describe the planned system (cardinal orientation: N,NNE,…,SSW,…);
# AI_* is any OpenAI-compatible endpoint (Kimi Code shown).
HOME_ADDRESS=
PV_PEAK_KWP=1.0
PV_ORIENTATION=SSW
PV_TILT_DEG=17
PV_PANEL_TYPE=
# Watts per PV panel (default 500) — together with PV_PEAK_KWP this derives
# the panel count the ROI baseline prompt states explicitly.
# PV_PANEL_W=500
AI_API_KEY=
AI_BASE_URL=https://api.kimi.com/coding/v1
AI_MODEL=k3
AI_LANGUAGE=en
